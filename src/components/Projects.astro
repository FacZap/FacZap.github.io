---
import Base from '../layouts/Base.astro';
import ProjectCards from './ProjectCards.astro';
import { t, type Lang } from '../i18n/ui';

interface Props { lang: Lang }
const { lang } = Astro.props;
const s = t(lang);
---
<Base lang={lang} title={s['projects.title']}>
  <section class="container">
    <div class="projects-head">
      <h1>{s['projects.title']}</h1>
      <div class="view-tools">
        <button id="count-toggle" class="tool" type="button" aria-label={s['projects.count']} title={s['projects.count']}>3</button>
      </div>
    </div>
    <ProjectCards lang={lang} />
  </section>
</Base>

<script>
  const grid = document.getElementById('projects-grid')!;
  const countBtn = document.getElementById('count-toggle')!;
  // Arranca con una cantidad que entre en pantalla; sin JS queda el auto-fill del CSS.
  let n = innerWidth < 640 ? 1 : innerWidth < 1000 ? 2 : 3;
  grid.dataset.flow = 'row';
  try {
        const saved_count = localStorage.getItem('saved-count');
        if (saved_count) n = (parseInt(saved_count) > 0 && parseInt(saved_count) < 5) ? parseInt(saved_count) : n;
        } catch {}
  const render = () => {
    grid.style.setProperty('--n', String(n));
    countBtn.textContent = String(n);
    localStorage.setItem('saved-count', String(n));
  };
  render();
  countBtn.addEventListener('click', () => {
    n = (n % 4) + 1;
    render();
  });
</script>

<style>
  .projects-head { display: flex; align-items: center; justify-content: space-between; gap: 1rem; }
  .view-tools { display: flex; gap: 0.5rem; }
  .tool {
    background: none;
    border: 1px solid var(--border);
    color: var(--text);
    border-radius: 4px;
    width: 2rem;
    height: 2rem;
    cursor: pointer;
    font-size: 1rem;
  }
</style>
