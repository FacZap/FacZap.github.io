---
import Base from '../layouts/Base.astro';
import { postsFor } from '../blog';
import { t, localePath, type Lang } from '../i18n/ui';

interface Props { lang: Lang }
const { lang } = Astro.props;
const s = t(lang);
const posts = await postsFor(lang);
---
<Base lang={lang} title={s['blog.title']}>
  <section class="container narrow">
    <h1>{s['blog.title']}</h1>
    {posts.length === 0 && <p class="muted">{s['blog.empty']}</p>}
    <ul class="posts">
      {posts.map(({ post, slug }) => (
        <li>
          <time class="muted" datetime={post.data.date.toISOString()}>{post.data.date.toLocaleDateString(lang, { timeZone: 'UTC' })}</time>
          <h2><a href={localePath(lang, `/blog/${slug}/`)}>{post.data.title}</a></h2>
          <p class="muted">{post.data.description}</p>
        </li>
      ))}
    </ul>
  </section>
</Base>

<style>
  .narrow { max-width: 48rem; }
  .posts { list-style: none; padding: 0; }
  .posts li { padding-block: 1.25rem; border-bottom: 1px solid var(--border); }
  h2 { margin: 0.25rem 0; font-size: 1.4rem; }
  h2 a { color: var(--text); text-decoration: none; }
  h2 a:hover { color: var(--accent); }
  time { font-size: 0.8rem; }
</style>
