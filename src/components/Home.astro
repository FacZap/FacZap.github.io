---
import Base from '../layouts/Base.astro';
import SocialLinks from './SocialLinks.astro';
import { site } from '../config';
import { projects } from '../data/projects';
import { t, type Lang } from '../i18n/ui';

interface Props { lang: Lang }
const { lang } = Astro.props;
const s = t(lang);
---
<Base lang={lang}>
  <section class="hero container">
    <div>
      <h1>{site.name}</h1>
      <p class="role">{s['hero.role']}</p>
      <p class="muted intro">{s['hero.intro']}</p>
      <p class="actions">
        <a class="btn btn-primary" href="#projects">{s['hero.cta']} ›</a>
        <a class="btn btn-ghost" href={site.links.cv[lang]}target="_blank" rel="noopener">{s['hero.cv']}</a>
      </p>
    </div>
    <img class="avatar" src={site.avatar} alt={site.name} width="320" height="320" />
  </section>

  <section id="about" class="container narrow">
    <h2>{s['about.title']}</h2>
    <p class="muted">{s['about.body']}</p>
  </section>

  <section id="projects" class="container">
    <div class="projects-head">
      <h2>{s['projects.title']}</h2>
      <div class="view-tools">
        <button id="flow-toggle" class="tool" type="button" aria-label={s['projects.flow']} title={s['projects.flow']}>⇄</button>
        <button id="count-toggle" class="tool" type="button" aria-label={s['projects.count']} title={s['projects.count']}>3</button>
      </div>
    </div>
    <ul class="grid" id="projects-grid">
      {projects.map((p) => (
        <li class="card">
          <h3>{p.title[lang]}</h3>
          <p class="muted">{p.description[lang]}</p>
          <p class="tags">{p.tags.map((tag) => <span>{tag}</span>)}</p>
          <p class="card-links">
            {p.repo && <a href={p.repo} target="_blank" rel="noopener">{s['projects.repo']}</a>}
            {p.demo && <a href={p.demo} target="_blank" rel="noopener">{s['projects.demo']}</a>}
          </p>
        </li>
      ))}
    </ul>
  </section>

  <section id="contact" class="container narrow">
    <h2>{s['contact.title']}</h2>
    <p class="muted">{s['contact.body']}</p>
    <div class="actions">
      <a class="btn btn-primary" href={`mailto:${site.email}`}>{s['contact.cta']}</a>
      <SocialLinks />
    </div>
  </section>
</Base>

<script>
  const grid = document.getElementById('projects-grid')!;
  const flowBtn = document.getElementById('flow-toggle')!;
  const countBtn = document.getElementById('count-toggle')!;
  // Arranca con una cantidad que entre en pantalla; sin JS queda el auto-fill del CSS.
  let n = innerWidth < 640 ? 1 : innerWidth < 1000 ? 2 : 3;
  const render = () => {
    grid.style.setProperty('--n', String(n));
    countBtn.textContent = String(n);
    flowBtn.textContent = grid.dataset.flow === 'col' ? '⇅' : '⇄';
  };
  grid.dataset.flow = 'row';
  render();
  flowBtn.addEventListener('click', () => {
    grid.dataset.flow = grid.dataset.flow === 'col' ? 'row' : 'col';
    render();
  });
  countBtn.addEventListener('click', () => {
    n = (n % 4) + 1;
    render();
  });
</script>

<style>
  .hero {
    display: grid;
    grid-template-columns: 1.3fr 1fr;
    align-items: center;
    gap: 3rem;
    min-height: 70vh;
  }
  h1 { font-size: clamp(2.5rem, 6vw, 4rem); margin: 0 0 0.5rem; }
  h2 { font-size: 2rem; }
  .role { color: var(--accent); font-weight: 700; margin: 0 0 1rem; }
  .intro { max-width: 36rem; }
  .actions { display: flex; flex-wrap: wrap; align-items: center; gap: 1rem; margin-top: 2rem; }
  .avatar { justify-self: center; width: min(100%, 320px); height: auto; aspect-ratio: 1; object-fit: cover; border-radius: 50%; }
  .narrow p { max-width: 48rem; }
  .grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(16rem, 1fr)); gap: 1.5rem; list-style: none; padding: 0; }
  /* row: n ítems por fila; col: n ítems por columna, las columnas sobrantes scrollean en horizontal */
  .grid[data-flow='row'] { grid-template-columns: repeat(var(--n), minmax(0, 1fr)); }
  .grid[data-flow='col'] {
    grid-auto-flow: column;
    grid-template-rows: repeat(var(--n), auto);
    grid-template-columns: none;
    grid-auto-columns: minmax(16rem, 1fr);
    overflow-x: auto;
  }
  .projects-head { display: flex; align-items: center; justify-content: space-between; gap: 1rem; }
  .view-tools { display: flex; gap: 0.5rem; }
  .tool {
    background: none;
    border: 1px solid var(--border);
    color: var(--text);
    border-radius: 4px;
    width: 2rem;
    height: 2rem;
    cursor: pointer;
    font-size: 1rem;
  }
  .card { border:1px solid var(--border); border-radius: 6px; padding: 1.5rem; background: var(--surface); }
  .card h3 { margin-top: 0; }
  .tags { display: flex; flex-wrap: wrap; gap: 0.5rem; font-size: 0.75rem; }
  .tags span { border: 1px solid var(--border); border-radius: 3px; padding: 0.1rem 0.5rem; }
  .card-links { display: flex; gap: 1rem; margin-bottom: 0; }
  @media (max-width: 768px) {
    .hero { grid-template-columns: 1fr; min-height: auto; padding-top: 2rem; }
    .avatar { grid-row: 1; width: 180px; }
  }
</style>
