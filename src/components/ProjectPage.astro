---
import { getCollection, render } from 'astro:content';
import Base from '../layouts/Base.astro';
import { projects } from '../data/projects';
import { t, localePath, switchPath, type Lang } from '../i18n/ui';

interface Props { lang: Lang; project: (typeof projects)[number] }
const { lang, project: p } = Astro.props;
const s = t(lang);
// Contenido largo opcional: src/content/projects/<lang>/<slug>.md
// getCollection en vez de getEntry: getEntry avisa en el build por cada proyecto sin .md
const [entry] = await getCollection('projects', (e) => e.id === `${lang}/${p.slug}`);
const Content = entry && (await render(entry)).Content;
---
<Base lang={lang} title={p.title[lang]} description={p.description[lang]}>
  <article class="container narrow">
    <p><a href={localePath(lang, '/projects/')}>{s['projects.back']}</a></p>
    <h1>{p.title[lang]}</h1>
    <p class="muted">{p.description[lang]}</p>
    <p class="tags">{p.tags.map((tag) => <span>{tag}</span>)}</p>
    <p class="links">
      {p.link && <a href={p.link} target="_blank" rel="noopener">{s['projects.link']}</a>}
      {p.repo && <a href={p.repo} target="_blank" rel="noopener">{s['projects.repo']}</a>}
      {p.demo && <a href={p.demo} target="_blank" rel="noopener">{s['projects.demo']}</a>}
    </p>
    {Content && <div class="body"><Content /></div>}
    <p class="muted meta"><a href={switchPath(lang, Astro.url.pathname)}>{s['lang.switch']}</a></p>
  </article>
</Base>

<style>
  .narrow { max-width: 48rem; padding-block: 3rem; }
  .meta { font-size: 0.85rem; }
  .tags { display: flex; flex-wrap: wrap; gap: 0.5rem; font-size: 0.75rem; }
  .tags span { border: 1px solid var(--border); border-radius: 3px; padding: 0.1rem 0.5rem; }
  .links { display: flex; gap: 1rem; }
  .body :global(img) { max-width: 100%; height: auto; border-radius: 6px; }
  .body :global(pre) { padding: 1rem; border-radius: 6px; overflow-x: auto; }
  .body :global(table) { border-collapse: collapse; display: block; overflow-x: auto; }
  .body :global(th), .body :global(td) { border: 1px solid var(--border); padding: 0.4rem 0.6rem; }
</style>
