  { name: 'YouTube', href: site.links.youtube, d: 'M23.5 6.2a3 3 0 0 0-2.1-2.1C19.5 3.6 12 3.6 12 3.6s-7.5 0-9.4.5A3 3 0 0 0 .5 6.2 31 31 0 0 0 0 12a31 31 0 0 0 .5 5.8 3 3 0 0 0 2.1 2.1c1.9.5 9.4.5 9.4.5s7.5 0 9.4-.5a3 3 0 0 0 2.1-2.1A31 31 0 0 0 24 12a31 31 0 0 0-.5-5.8zM9.6 15.6V8.4l6.3 3.6-6.3 3.6z' },
  { name: 'X', href: site.links.x, d: 'M18.9 1.2h3.7l-8 9.2L24 22.8h-7.4l-5.8-7.6-6.6 7.6H.5l8.6-9.8L0 1.2h7.6l5.2 6.9 6.1-6.9zm-1.3 19.4h2L6.5 3.2H4.3l13.3 17.4z' },
];
---
<ul class="social">
  {icons.map((i) => (
    <li>
      <a href={i.href} aria-label={i.name} title={i.name} rel="me noopener" target="_blank">
        <svg viewBox="0 0 24 24" width="20" height="20" fill="currentColor" aria-hidden="true"><path d={i.d} /></svg>
      </a>
    </li>
  ))}
</ul>

<style>
  .social { display: flex; gap: 1rem; list-style: none; margin: 0; padding: 0; }
  a { color: var(--muted); display: block; }
  a:hover { color: var(--text); }
</style>
